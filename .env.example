# Copia este fichero a `.env` para sobrescribir las credenciales de desarrollo local de
# docker-compose.yml. Ninguna de estas variables se usa fuera de local: son solo para que
# `docker compose up -d` + `mvn spring-boot:run -Dspring-boot.run.profiles=local` funcione
# sin tocar código. No confundir con secretos de servidor, que no viven en este repositorio.

POSTGRES_USER=academia
POSTGRES_PASSWORD=academia_dev
POSTGRES_DB=academia

MINIO_ROOT_USER=academia
MINIO_ROOT_PASSWORD=academia_dev_minio
