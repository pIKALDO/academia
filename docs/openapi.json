            "maxLength" : 30,
            "minLength" : 0
          },
          "priority" : {
            "type" : "integer",
            "format" : "int32",
            "maximum" : 99,
            "minimum" : 1
          },
          "relationship" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        },
        "required" : [ "name", "phone" ]
      },
      "CreateGuardianRequest" : {
